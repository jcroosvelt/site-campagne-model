# ─────────────────────────────────────────────────────────────
#  Configuration — copier ce fichier en .env et compléter.
#  Ne JAMAIS committer le fichier .env. Aucune de ces valeurs
#  n'est exposée au navigateur (aucun préfixe NEXT_PUBLIC_ secret).
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final) — utilisée pour les liens, webhooks, e-mails
APP_URL="http://localhost:3000"

# Base PostgreSQL (locale, Supabase, Neon, RDS…)
DATABASE_URL="postgresql://campagne:campagne@localhost:5432/campagne?schema=public"

# Secret aléatoire (≥ 32 caractères) : `openssl rand -hex 32`
# Sert au hachage des identifiants de visiteurs et à la signature de jetons.
APP_SECRET="change-me-to-a-long-random-string-of-64-hex-chars"

# ── E-mail (SMTP) ── sans SMTP_HOST les e-mails sont journalisés en console (dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Campagne <no-reply@exemple.ht>"

# ── Stockage des fichiers ── "local" (public/uploads) ou "supabase"
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="public-media"

# ── Paiement par carte (Stripe Checkout — Visa / Mastercard) ──
# Laisser vide tant que le compte marchand et la conformité ne sont pas validés.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── MonCash (Digicel) — API marchande ──
# MONCASH_MODE = "sandbox" ou "live"
MONCASH_MODE="sandbox"
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""
# Secret partagé ajouté à l'URL de notification configurée dans le portail MonCash
# (ex. https://votre-site/api/webhooks/moncash?key=XXXX). La notification ne fait
# que déclencher une re-vérification côté serveur auprès de l'API MonCash.
MONCASH_NOTIFY_KEY=""

# ── Compte administrateur initial (utilisé par `npm run admin:create`) ──
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Super administrateur"
